{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json",
  "title": "HyperTest Artifact Reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema",
    "uri",
    "mediaType",
    "sha256"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sourceRevision": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
