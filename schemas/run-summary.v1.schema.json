{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypertest.dev/schemas/run-summary.v1.schema.json",
  "title": "HyperTest Run Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "sourceRevision",
    "finalState",
    "modelUsage",
    "ledger",
    "gateDecisions",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "hypertest.run-summary/v1"
    },
    "runId": {
      "type": "string"
    },
    "sourceRevision": {
      "type": "string"
    },
    "finalState": {
      "enum": [
        "planned",
        "verified",
        "completed",
        "needs_human",
        "rejected",
        "failed"
      ]
    },
    "testPlan": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "test-plan" },
            "schema": { "const": "hypertest.test-plan/v1" }
          }
        }
      ]
    },
    "patch": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "patch" },
            "schema": { "const": "hypertest.patch/v1" }
          }
        }
      ]
    },
    "testRun": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "test-run" },
            "schema": { "const": "hypertest.test-run/v1" }
          }
        }
      ]
    },
    "coverage": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "coverage-map" },
            "schema": { "const": "hypertest.coverage-map/v1" }
          }
        }
      ]
    },
    "diagnosis": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "diagnosis" },
            "schema": { "const": "hypertest.diagnosis/v1" }
          }
        }
      ]
    },
    "modelUsage": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "model-usage" },
            "schema": { "const": "hypertest.model-usage/v1" }
          }
        }
      ]
    },
    "ledger": {
      "allOf": [
        { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "properties": {
            "kind": { "const": "run-ledger" },
            "schema": { "const": "hypertest.run-ledger/v1" }
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 }
      }
    },
    "gateDecisions": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "https://hypertest.dev/schemas/artifact-ref.v1.schema.json" },
          {
            "type": "object",
            "required": ["kind", "schema"],
            "properties": {
              "kind": { "const": "gate-decision" },
              "schema": { "const": "hypertest.gate-decision/v1" }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
